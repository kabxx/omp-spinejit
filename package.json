{
  "name": "@kabxx/omp-spinejit",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "author": "GhabiX",
  "description": "SpineJIT context management for OMP, backed by the portable Spine SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kabxx/omp-spinejit.git"
  },
  "bugs": {
    "url": "https://github.com/kabxx/omp-spinejit/issues"
  },
  "homepage": "https://github.com/kabxx/omp-spinejit#readme",
  "keywords": [
    "omp-package",
    "spinejit"
  ],
  "omp": {
    "extensions": [
      "./dist/omp/extension.js"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/omp/index.d.ts",
      "import": "./dist/omp/index.js"
    },
    "./extension": {
      "types": "./dist/omp/extension.d.ts",
      "import": "./dist/omp/extension.js"
    },
    "./tree-view": {
      "types": "./dist/omp/tree-view-contract.d.ts",
      "import": "./dist/omp/tree-view-contract.js"
    }
  },
  "files": [
    "dist",
    "spine.toml",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "doc/HOST.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && bun test test/*.test.mjs",
    "pretest:native": "npm run build",
    "test:native": "node --test --test-concurrency=1 test/native-host/*.test.mjs",
    "test:stock": "node --test --test-concurrency=1 test/native-host/stock-*.test.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@spinejit/spine-sdk": "0.1.4"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "19.0.0",
    "@oh-my-pi/pi-agent-core": "19.0.0",
    "@oh-my-pi/pi-coding-agent": "19.0.0",
    "@oh-my-pi/pi-tui": "19.0.0",
    "ws": "8.22.0",
    "typescript": "5.9.3",
    "@types/node": "22.19.21"
  }
}
